<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EventVsBindingMauiApp.MainPage"
             BackgroundColor="WhiteSmoke">

    <ScrollView>
        <StackLayout>
            <Slider x:Name="rotationSlider"
                Maximum="360"
                MaximumTrackColor="Aqua"
                Minimum="0"
                MinimumTrackColor="Bisque"
                ValueChanged="Slider_ValueChanged"
                Value="20" />
            <Label x:Name="rotationLabel"
               Margin="40"
               BackgroundColor="Bisque"
               HorizontalOptions="Center"
               Rotation="90"
               Text="To jest label" />

            <Label Margin="40"
               BackgroundColor="Bisque"
               HorizontalOptions="Center"
               BindingContext="{x:Reference rotationLabel}"
               Rotation="{Binding Value }"
               Text="{Binding Source={x:Reference rotationSlider}, Path=Value, StringFormat='To jest wartość: {0:f}'}" />

        </StackLayout>
    </ScrollView>

</ContentPage>

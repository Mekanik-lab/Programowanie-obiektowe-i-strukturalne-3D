<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EventVsBindingMauiApp.MainPage"
             BackgroundColor="WhiteSmoke">

    <ScrollView>
        <StackLayout>
            <Slider Minimum="0"
                    Maximum="360"
                    Margin="40"
                    Value="0"
                    MinimumTrackColor="Bisque"
                    MaximumTrackColor="Aqua"
                    ValueChanged="Slider_ValueChanged"
                    x:Name="sliderRotation"/>

            <Slider Minimum="0"
                    Maximum="360"
                    Margin="40"
                    Value="0"
                    MinimumTrackColor="Bisque"
                    MaximumTrackColor="Aqua"
                    ValueChanged="Slider_ValueChanged"
                    x:Name="sliderRotation2"/>   

            <Label HorizontalOptions="Center"
                   Margin="40"
                   TextColor="Black"
                   Rotation="{Binding Source={x:Reference sliderRotation}, Path=Value}"
                   Text="{Binding Source={x:Reference sliderRotation}, Path=Value}" />
        </StackLayout>
    </ScrollView>

</ContentPage>
